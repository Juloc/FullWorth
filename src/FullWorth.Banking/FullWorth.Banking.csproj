<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Shared\SecretBootstrap.cs" Link="SecretBootstrap.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- FullWorth.Web references this project with AdditionalProperties="FullWorthUnifiedReference=true".
         Global properties propagate down the reference chain, so without dropping it here FinTs exists as
         two distinct project instances that build concurrently and both write
         FullWorth.FinTs/bin/.../FullWorth.FinTs.deps.json - which fails the release with
         "GenerateDepsFile task failed unexpectedly: the process cannot access the file". FinTs does not
         read the flag, so removing it collapses the two instances into one and keeps the publish parallel. -->
    <ProjectReference Include="../FullWorth.FinTs/FullWorth.FinTs.csproj" GlobalPropertiesToRemove="FullWorthUnifiedReference" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
