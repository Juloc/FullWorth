<!-- Microsoft.NET.Sdk.WebAssembly, not Microsoft.NET.Sdk: with the plain SDK, publish emitted managed
     DLLs and nothing else - no _framework, no dotnet.js, no app bundle at all. This SDK is the one that
     produces a loadable browser bundle. -->
<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WasmMainJSPath>main.js</WasmMainJSPath>
    <!-- No threads and no globalization data: the calculator formats nothing, it returns numbers, and
         invariant mode keeps the download small. -->
    <WasmEnableThreads>false</WasmEnableThreads>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Trimming is what keeps this downloadable: untrimmed, the publish output was ~25 MB. It is only
         safe because the JSON round-trip uses a source-generated context (WasmJson in
         CompensationApi.cs) instead of the reflection-based serializer, which trimming quietly breaks.
         If a new type crosses the JS boundary it must be added there. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <!-- Trimming defaults this to true, which replaces framework exception messages with their resource
         KEYS. Verified in the browser: a malformed profile came back as
         "ExpectedStartOfPropertyNotFound, n Path:" and a bad employment period appended
         "Arg_ParamName_Name, EmploymentEnd". Those strings are what a visitor on the landing page would
         read, so the few KB of resources are worth it. -->
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <!-- Required by JSExportAttribute: the generated interop marshalling is unsafe code (SYSLIB1075).
         Scoped to this project - FullWorth.Compensation.Core stays safe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FullWorth.Compensation.Core\FullWorth.Compensation.Core.csproj" />
  </ItemGroup>
</Project>
