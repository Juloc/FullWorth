    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FullWorth.Web.Tests" />
  </ItemGroup>
</Project>
