@page "/accounts"
@inject FullWorth.Web.Navigation.LocaleText Text
@{
    var language = FullWorth.Web.Navigation.LocaleText.Language(ViewContext.HttpContext);
    ViewData["Title"] = "Konten · FullWorth";
    ViewData["ActiveView"] = "accounts";
}

@*
    Eine eigene Seite (#154 Phase C): ihr Markup, ihr CSS, ihr JS - und nichts von den anderen.
    Das Markup stand bis hierher in wwwroot/pages/accounts/page.html, von wo
    ops/generate-shell.mjs es in das eine grosse Dokument geschrieben hat.
*@

<section id="view-accounts"><article class="panel"><div class="panel-head"><h2 data-i18n="accounts.title">@Text.Get("accounts.title", language)</h2><div class="panel-head-actions"><label class="accounts-search"><svg class="accounts-search-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><use href="@IconSprite.Href(ViewContext.HttpContext, "ui-search")"></use></svg><input id="accounts-search" type="search" data-i18n-placeholder="accounts.search" placeholder="@Text.Get("accounts.search", language)" aria-label="Konto suchen"></label><button id="add-group" class="btn btn-secondary ux-icon-text-button" data-ux-icon="grip" title="Gruppen" aria-label="Gruppen"><svg class="ux-button-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="@IconSprite.Href(ViewContext.HttpContext, "ui-grip")"></use></svg><span class="ux-button-label" data-i18n="accounts.groups">@Text.Get("accounts.groups", language)</span></button><button id="add-account" class="ux-icon-text-button" data-ux-icon="plus" title="Konto hinzufügen" aria-label="Konto hinzufügen"><svg class="ux-button-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="@IconSprite.Href(ViewContext.HttpContext, "ui-plus")"></use></svg><span class="ux-button-label" data-i18n="accounts.add">@Text.Get("accounts.add", language)</span></button></div></div><div id="accounts-view-list" class="rows"></div></article></section>

@section Styles {
    <link rel="stylesheet" href="~/styles/bank-connections.css">
    <link rel="stylesheet" href="~/styles/investment-performance.css">
    <link rel="stylesheet" href="~/pages/accounts/page.css">
}

@section Scripts {
    <script type="module" src="~/pages/accounts/entry.js"></script>
}
