@page "/compensation"
@inject FullWorth.Web.Navigation.LocaleText Text
@{
    var language = FullWorth.Web.Navigation.LocaleText.Language(ViewContext.HttpContext);
    ViewData["Title"] = "Gehalt & Benefits · FullWorth";
    ViewData["ActiveView"] = "compensation";
}

@*
    Eine eigene Seite (#154 Phase C): ihr Markup, ihr CSS, ihr JS - und nichts von den anderen.
    Das Markup stand bis hierher in wwwroot/pages/compensation/page.html, von wo
    ops/generate-shell.mjs es in das eine grosse Dokument geschrieben hat.
*@

<section id="view-compensation" class="comp-view">
      @* Zwei Ebenen statt elf Reitern nebeneinander: vier Gruppen oben, darunter nur die Reiter der gewählten Gruppe.

         Alle Reiter stehen im Markup, auch die der Nachbarmodule, und ihre Reihenfolge ist fest: Bis #154 hingen vier
         davon sich selbst per insertAdjacentHTML in die Leiste, sobald ihr Modul geladen war - also nach dem ersten
         Bild - und drückten die Reiter dahinter um 162 px nach rechts. Jedes Modul bindet nur an seinen Knopf; welche
         Reiter sichtbar sind, entscheiden allein data-group (page.js und page.css). *@
      <nav class="comp-groups" aria-label="Bereiche">
        <button class="active" data-group-tab="gehalt" type="button">Mein Gehalt</button>
        <button data-group-tab="verlauf" type="button">Verlauf</button>
        <button data-group-tab="planen" type="button">Planen</button>
        <button data-group-tab="mehr" type="button">Mehr</button>
        <label class="comp-space-label" hidden>Finanzbereich <select id="space-select"></select></label>
      </nav>
      <nav class="comp-tabs" data-active-group="gehalt" aria-label="Unterbereiche">
        <button class="active" data-tab="overview" data-group="gehalt" type="button">Mein Gehalt</button>
        <button data-history-tab="history" data-group="verlauf" type="button">Verlauf</button>
        <button data-tab="calculator" data-group="planen" type="button">Rechner</button>
        <button data-tab="scenarios" data-group="planen" type="button">Szenarien</button>
        <button data-extended-tab="optimizer" data-group="planen" type="button">Optimierer</button>
        <button data-tab="negotiation" data-group="planen" type="button">Gehaltsgespräch</button>
        <button data-tab="benefits" data-group="mehr" type="button">Benefits</button>
        <button data-jobrad-tab="jobrad" data-group="mehr" type="button">Dienstrad</button>
        <button data-income-tab="other-income" data-group="mehr" type="button">Weitere Einkünfte</button>
      </nav>

      <section id="tab-overview" class="comp-tab active"><div id="gehalt-overview"></div></section>

      <section id="tab-calculator" class="comp-tab">
        <div class="comp-calc-actions"><button id="save-profile" class="btn btn-primary" type="button">Profil speichern</button></div>
        <div class="comp-layout">
          <div class="comp-form-stack">
            <article class="panel comp-card">
              <div class="panel-head"><div><span class="step">1</span><h2>Gehalt</h2></div></div>
              <div class="form-grid">
                <label>Brutto eingeben als
                  <select id="gross-period"><option value="monthly">Monatsbrutto</option><option value="annual">Jahresbrutto</option></select>
                  <small class="field-help">Nimm die Angabe aus deinem Arbeitsvertrag.</small>
                </label>
                <label><span id="gross-amount-title">Monatsbrutto</span>
                  <input id="gross-input" type="number" min="0" step="50" value="5000">
                  <small id="gross-annual-preview" class="field-help">= 60.000 € Jahresbrutto</small>
                </label>
                <label id="salary-payments-field">Gehälter pro Jahr
                  <select id="salary-payments"><option value="12">12 Gehälter</option><option value="13">13 Gehälter</option><option value="14">14 Gehälter</option></select>
                  <small class="field-help">13./14. Gehalt wird im Planungsrechner ins Jahresbrutto eingerechnet.</small>
                </label>
                <label>Bonus pro Jahr<input id="annual-bonus" type="number" min="0" step="100" value="0"><small class="field-help">Zusätzlicher Bonus außerhalb der gewählten Gehälter.</small></label>
                <label>Steuerklasse
                  <select id="tax-class"><option>1</option><option>2</option><option>3</option><option>4</option><option>5</option><option>6</option></select>
                  <small class="field-help">Steht in deinen ELStAM bzw. auf der Lohnabrechnung.</small>
                </label>
                <label id="tax-factor-field" hidden>Faktor bei Steuerklasse IV
                  <input id="tax-class4-factor" type="number" min="0.001" max="1" step="0.001" value="1.000" placeholder="z. B. 0,873">
                  <small class="field-help">Nur bei IV mit Faktor. Den Wert legt das Finanzamt fest.</small>
                </label>
                <label>Bundesland<select id="state-code">
                  <option value="BW">Baden-Württemberg</option><option value="BY">Bayern</option><option value="BE">Berlin</option><option value="BB">Brandenburg</option><option value="HB">Bremen</option><option value="HH">Hamburg</option><option value="HE">Hessen</option><option value="MV">Mecklenburg-Vorpommern</option><option value="NI">Niedersachsen</option><option value="NW">Nordrhein-Westfalen</option><option value="RP">Rheinland-Pfalz</option><option value="SL">Saarland</option><option value="SN">Sachsen</option><option value="ST">Sachsen-Anhalt</option><option value="SH">Schleswig-Holstein</option><option value="TH">Thüringen</option>
                </select></label>
                <label>Steuerjahr
                  <select id="tax-year">
                    <option value="">Automatisch (neuestes Recht)</option>
                    <option value="2026">2026</option>
                    <option value="2025">2025</option>
                    <option value="2024">2024</option>
                    <option value="2023">2023</option>
                    <option value="2022">2022</option>
                    <option value="2021">2021</option>
                    <option value="2020">2020</option>
                    <option value="2019">2019</option>
                    <option value="2018">2018</option>
                  </select>
                  <small class="field-help">Rechtsstand der Berechnung. „Automatisch“ nutzt das neueste hinterlegte Jahr und lässt gespeicherte Verlaufsstände im jeweiligen Jahr rechnen.</small>
                </label>
                <label>Kinder unter 25<input id="children" type="number" min="0" max="10" step="1" value="0"></label>
              </div>
              <div class="check-row">
                <label><input id="church-tax" type="checkbox"> Kirchensteuer</label>
              </div>
              <details class="comp-advanced">
                <summary>Weitere Angaben</summary>
                <div class="form-grid">
                  <label>Bezeichnung<input id="profile-name" value="Aktuelles Gehalt"></label>
                  <label>GKV-Zusatzbeitrag %<input id="health-addon" type="number" min="0" max="10" step="0.1" placeholder="Durchschnitt des Steuerjahres"><small class="field-help">Leer lassen, um den gesetzlichen Durchschnitt des jeweiligen Steuerjahres zu verwenden (2018 waren es 1,0 %, 2026 sind es 2,9 %). Nur ausfüllen, wenn du den Zusatzbeitrag deiner Krankenkasse kennst.</small></label>
                  <label>Jährlicher ELStAM-Freibetrag<input id="annual-tax-allowance" type="number" min="0" step="100" value="0"><small class="field-help">Nur eintragen, wenn ein Freibetrag in deinen ELStAM hinterlegt ist.</small></label>
                  <label>Kinderfreibetrag laut ELStAM<input id="child-allowance-units" type="number" min="0" max="10" step="0.5" placeholder="automatisch"><small class="field-help">Leer lassen = aus Kinderzahl und Steuerklasse ableiten.</small></label>
                  <label>Geburtsdatum<input id="birth-date" type="date"><small class="field-help">Daraus wird das Alter im gewählten Steuerjahr berechnet – wichtig für den Pflegeversicherungs-Zuschlag und historische Jahre.</small></label>
                  <label>Alter<input id="employee-age" type="number" min="0" max="120" step="1" placeholder="optional"><small id="employee-age-help" class="field-help">Relevant für den Pflegeversicherungs-Zuschlag. Mit Geburtsdatum wird das Alter automatisch berechnet.</small></label>
                  <label>Beschäftigung von<input id="employment-start" type="date"><small class="field-help">Nur nötig, wenn du nicht das ganze Steuerjahr beschäftigt warst – zum Beispiel bei einem Jobwechsel. Leer = ganzes Jahr.</small></label>
                  <label>Beschäftigung bis<input id="employment-end" type="date"><small class="field-help">Leer = weiterhin beschäftigt. Teilmonate zählen nach Payroll-Konvention mit 30 SV-Tagen.</small></label>
                  <label>Wochenstunden<input id="weekly-hours" type="number" min="1" max="80" step="0.5" value="40"><small class="field-help">Für den Wert pro Arbeitsstunde.</small></label>
                  <label>Urlaubstage<input id="vacation-days" type="number" min="0" max="60" step="1" value="30"><small class="field-help">Für den Wert pro Arbeitsstunde.</small></label>
                </div>
                <div class="check-row">
                  <label><input id="childless-surcharge" type="checkbox" checked> Pflege-Zuschlag kinderlos</label>
                  <label><input id="pension-insurance" type="checkbox" checked> Rentenversicherung</label>
                  <label><input id="unemployment-insurance" type="checkbox" checked> Arbeitslosenversicherung</label>
                </div>
              </details>
            </article>

            <article class="panel comp-card">
              <div class="panel-head">
                <div><span class="step">2</span><h2>Einmalige Sonderzahlungen</h2></div>
                <div class="oneoff-add">
                  <label>Vorlage<select id="oneoff-preset"></select></label>
                  <button id="add-oneoff" class="btn btn-secondary" type="button">Hinzufügen</button>
                </div>
              </div>
              <div id="oneoff-list" class="oneoff-list"></div>
            </article>

            <article class="panel comp-card">
              <div class="panel-head"><div><span class="step">3</span><h2>Firmenwagen</h2></div><label class="switch-row"><input id="car-enabled" type="checkbox"> aktiv</label></div>
              <div id="car-fields" class="form-grid muted-fields">
                <label>Fahrzeugart
                  <select id="car-vehicle-type"><option value="combustion">Verbrenner</option><option value="electric">Elektroauto</option><option value="hybrid">Plug-in-Hybrid</option><option value="manual">Regel manuell wählen</option></select>
                  <small class="field-help">FullWorth bestimmt daraus automatisch die passende Listenpreis-Regel.</small>
                </label>
                <label>Bruttolistenpreis<input id="car-list-price" type="number" min="0" step="500" value="50000"></label>
                <label>Anschaffungs-/Überlassungsdatum<input id="car-acquisition-date" type="date" value="2026-01-01"></label>
                <label id="car-factor-field" hidden>Bewertungsregel<select id="car-factor"><option value="1">1,0 %</option><option value="0.5">0,5 %</option><option value="0.25">0,25 %</option></select></label>
                <label id="car-range-field" hidden>Elektrische Reichweite km<input id="car-electric-range" type="number" min="0" step="1" value="80"></label>
                <label id="car-co2-field" hidden>CO₂ g/km<input id="car-co2" type="number" min="0" step="1" value="50"></label>
                <div id="car-rule-summary" class="field-summary">Regel: 1,0 % vom Bruttolistenpreis.</div>
                <label>Einfacher Arbeitsweg km<input id="car-commute" type="number" min="0" step="1" value="0"></label>
                <label>Arbeitsweg abrechnen
                  <select id="car-commute-method"><option value="monthly">Pauschal 0,03 % / Monat</option><option value="daily">Einzeltage 0,002 % / Tag</option></select>
                </label>
                <label id="car-commute-days-field" hidden>Fahrten zur Arbeit / Monat<input id="car-commute-days" type="number" min="0" max="31" step="1" value="10"></label>
                <label>Eigenanteil / Monat<input id="car-contribution" type="number" min="0" step="10" value="0"></label>
                <label>Arbeitgeberkosten / Monat<input id="car-employer-cost" type="number" min="0" step="10" value="0"><small class="field-help">Optional, für Arbeitgeberkosten und Angebotsvergleich.</small></label>
                <label>Privates Auto alternativ / Monat<input id="car-private-cost" type="number" min="0" step="10" value="0"><small class="field-help">Optional, für deinen persönlichen FullWorth-Wert.</small></label>
              </div>
            </article>

            <article class="panel comp-card">
              <div class="panel-head"><div><span class="step">4</span><h2>Betriebliche Altersvorsorge</h2></div></div>
              <div class="form-grid">
                <label>Eigener Beitrag / Monat<input id="bav-employee" type="number" min="0" step="10" value="0"></label>
                <label>Arbeitgeber / Monat<input id="bav-employer" type="number" min="0" step="10" value="0"></label>
                <label>Projektion Jahre<input id="bav-years" type="number" min="1" max="60" step="1" value="30"></label>
                <label>Annahme Rendite % p.a.<input id="bav-return" type="number" min="-20" max="20" step="0.1" value="3"></label>
              </div>
            </article>

            <button id="calculate" class="btn btn-primary comp-calculate" type="button">Neu berechnen</button>
          </div>

          <aside class="comp-results" aria-live="polite">
            <article class="panel comp-result-primary">
              <span id="result-net-label">Netto normaler Monat</span>
              <strong id="result-net-month">—</strong>
              <small id="result-net-year">—</small>
            </article>
            <div class="metric-grid comp-metrics">
              <article class="metric"><span>Arbeitgeberkosten</span><strong id="result-employer">—</strong></article>
              <article class="metric"><span>Gesamtwert für dich</span><strong id="result-fullworth">—</strong><small class="field-help">Netto + persönlicher Wert von Firmenwagen, bAV und Benefits.</small></article>
              <article class="metric"><span>Nächste 100 € brutto</span><strong id="result-marginal">—</strong></article>
              <article class="metric"><span>Wert pro Arbeitsstunde</span><strong id="result-hourly">—</strong></article>
            </div>
            <article class="panel comp-breakdown">
              <h2>Abzüge pro Jahr</h2>
              <div id="deduction-rows" class="result-rows"></div>
            </article>
            <article class="panel comp-breakdown">
              <h2>Benefits</h2>
              <div id="benefit-summary" class="result-rows"></div>
            </article>
            <article class="panel comp-assumptions">
              <h2>Annahmen</h2>
              <p id="assumptions">Noch keine Berechnung.</p>
            </article>
          </aside>
        </div>
      </section>

      <section id="tab-benefits" class="comp-tab">
        <article class="panel comp-card wide">
          <div class="panel-head"><div><h2>Weitere Benefits</h2></div><button id="add-benefit" class="btn btn-secondary" type="button">Benefit hinzufügen</button></div>
          <div id="benefits-list" class="benefits-list"></div>
        </article>
      </section>

      <section id="tab-negotiation" class="comp-tab">
        <div class="comp-layout negotiation-layout">
          <article class="panel comp-card">
            <div class="panel-head"><div><h2>Gehaltsgespräch vorbereiten</h2></div></div>
            <div class="neg-fill"><button id="fill-negotiation" class="btn btn-secondary" type="button">Neu aus Verträgen und Abrechnungen füllen</button><small id="neg-fill-note" class="extended-note">Gehalt vor deiner letzten Erhöhung und heute, aus deinen Vertragsständen.</small></div>
            <div class="form-grid">
              <label>Gehalt damals<input id="neg-old-salary" type="number" min="1" step="100"></label>
              <label>Datum damals<input id="neg-old-date" type="date"></label>
              <label>Aktuelles Gehalt<input id="neg-current-salary" type="number" min="0" step="100"></label>
              <label>Gewünschtes Gehalt<input id="neg-desired-salary" type="number" min="0" step="100"></label>
              <label>Zusätzlicher realer Aufschlag %<input id="neg-real-adjustment" type="number" min="-50" max="100" step="0.1" value="0"></label>
              <label>Vergleichsdatum<input id="neg-date" type="date"></label>
            </div>
            <button id="analyze-negotiation" class="btn btn-primary" type="button">Kaufkraft prüfen</button>
          </article>
          <aside class="comp-results">
            <article class="panel comp-result-primary inflation-result"><span>Kaufkrafterhalt heute</span><strong id="neg-maintenance">—</strong><small id="neg-inflation">—</small></article>
            <div class="metric-grid comp-metrics">
              <article class="metric"><span>Aktuell nominal</span><strong id="neg-current-nominal">—</strong></article>
              <article class="metric"><span>Aktuell real</span><strong id="neg-current-real">—</strong></article>
              <article class="metric"><span>Wunsch real</span><strong id="neg-desired-real">—</strong></article>
              <article class="metric"><span>Referenz + Aufschlag</span><strong id="neg-reference">—</strong></article>
            </div>
            <article class="panel comp-breakdown"><h2>Einordnung</h2><div id="neg-explanation" class="neg-explanation">Noch keine Analyse.</div></article>
            <article class="panel comp-assumptions"><h2>Inflationsdaten</h2><p id="inflation-source">—</p></article>
          </aside>
        </div>
      </section>

      @* Verlauf: Abrechnungen, Verträge und gespeicherte Planungsstände in EINER Zeitachse, Jahr für Jahr, neueste zuerst
         (verlauf.js). Ein Jahr klappt zu seinen Monaten auf; die Gehaltsänderungen aus den Verträgen stehen als Ereignisse
         im Jahr. Hinzufügen - Paperless, PDF, von Hand, Vertragsstand - ist ein Dialog (add-dialog.js), keine Karte
         am Ende der Seite. *@
      <section id="tab-verlauf" class="comp-tab">
        <div class="vl-head"><button id="verlauf-add-open" class="btn btn-primary" type="button">Hinzufügen</button></div>
        <div id="contract-hints" class="po-hints vl-hints"></div>
        <div id="verlauf-years" class="vl-years"></div>
        <details id="verlauf-contracts" class="vl-more">
          <summary>Vertragsverlauf</summary>
          <div class="contract-overview">
            <article class="co-chart">
              <div class="po-legend"><span><i class="cc-key-line"></i>Vertrag</span><span><i class="cc-key-dot is-ok"></i>Abrechnung entspricht</span><span><i class="cc-key-dot is-off"></i>Abrechnung weicht ab</span></div>
              <div class="cc-wrap"><div id="contract-chart"></div><div class="cc-tip" hidden></div></div>
            </article>
            <article class="co-log"><div id="contract-log"></div></article>
          </div>
        </details>
        <details id="verlauf-planned" class="vl-more" hidden>
          <summary>Planungsstände aus dem Rechner</summary>
          <div id="history-planned"></div>
        </details>
      </section>

      <section id="tab-scenarios" class="comp-tab">
        <div class="scenario-toolbar panel">
          <div><h2>Szenarien</h2></div>
          <div><input id="scenario-name" placeholder="z. B. Angebot A"><button id="save-scenario" class="btn btn-primary" type="button">Szenario speichern</button></div>
        </div>
        <div id="scenario-list" class="scenario-grid"></div>
        <article id="scenario-comparison" class="panel scenario-comparison" hidden>
          <div class="panel-head"><h2>Vergleich</h2><button id="clear-comparison" class="btn btn-secondary" type="button">Auswahl löschen</button></div>
          <div id="comparison-content"></div>
        </article>
      </section>

      @* Hinzufügen: ein Dialog für alles, was in den Verlauf kommt. Die Felder behalten ihre Ids - extended.js (Abrechnungen,
         Hochladen) und contracts.js (Vertragsstände) lesen und füllen sie wie zuvor; nur der Ort ist ein anderer. Welcher
         Bereich zu sehen ist, steht in data-va-panel (add-dialog.js). *@
      <dialog id="verlauf-add" class="fw-dialog fw-dialog--sheet va-dialog" aria-labelledby="verlauf-add-title">
        <div class="dialog-card fw-dialog-card va-card">
          <div class="panel-head fw-dialog-head">
            <h2 id="verlauf-add-title">Hinzufügen</h2>
            <button type="button" class="fw-dialog-close" data-close aria-label="Schließen"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="@IconSprite.Href(ViewContext.HttpContext, "ui-close")"></use></svg></button>
          </div>
          @* Zwei Ebenen: erst WAS (Lohnabrechnung oder Vertrag), dann WIE (Paperless, PDF, von Hand). Welche Knöpfe der
             zweiten Zeile zu sehen sind, steht in data-va-for (add-dialog.js). *@
          <nav class="va-tabs" role="tablist" aria-label="Was hinzufügen">
            <button type="button" role="tab" class="po-year" data-va-what="payslip">Lohnabrechnung</button>
            <button type="button" role="tab" class="po-year" data-va-what="contract">Vertrag</button>
          </nav>
          <nav class="va-tabs va-how" role="tablist" aria-label="Wie hinzufügen">
            <button type="button" role="tab" class="va-how-tab" data-va-tab="paperless" data-va-for="payslip">Aus Paperless</button>
            <button type="button" role="tab" class="va-how-tab" data-va-tab="upload" data-va-for="payslip">PDF hochladen</button>
            <button type="button" role="tab" class="va-how-tab" data-va-tab="payslip" data-va-for="payslip">Von Hand</button>
            <button type="button" role="tab" class="va-how-tab" data-va-tab="contract-paperless" data-va-for="contract">Aus Paperless</button>
            <button type="button" role="tab" class="va-how-tab" data-va-tab="contract" data-va-for="contract">Von Hand</button>
          </nav>

          <section data-va-panel="paperless">
            <div id="paperless-body" class="paperless-body"><p class="extended-note">Wird geladen …</p></div>
          </section>

          <section data-va-panel="contract-paperless" hidden>
            <div id="contract-finds" class="paperless-body"><p class="extended-note">Wird geladen …</p></div>
          </section>

          <section data-va-panel="upload" hidden>
            <div class="va-upload">
              <input id="payslip-file" type="file" multiple accept="application/pdf,image/jpeg,image/png,image/webp,image/tiff,image/bmp" aria-label="Lohnabrechnung als Datei">
              <button id="payslip-extract" class="btn btn-primary" type="button">Analysieren</button>
              <button id="payslip-extract-batch" class="btn btn-secondary" type="button">Alle analysieren</button>
            </div>
            <p id="payslip-extraction-status" class="extended-note" hidden></p>
            <div id="payslip-batch" class="payslip-batch" hidden></div>
          </section>

          <section data-va-panel="payslip" hidden>
            <p id="ps-review-hint" class="extended-note"></p>
            <div class="form-grid payslip-fields">
              <label>Abrechnungsdatum<input id="ps-period" type="date"></label>
              <label>Brutto<input id="ps-gross" type="number" min="0" step="0.01"></label>
              <label>Netto<input id="ps-net" type="number" min="0" step="0.01"></label>
              <label>Auszahlung<input id="ps-payout" type="number" min="0" step="0.01"></label>
              <label>Lohnsteuer<input id="ps-tax" type="number" min="0" step="0.01"></label>
              <label>Soli<input id="ps-soli" type="number" min="0" step="0.01"></label>
              <label>Kirchensteuer<input id="ps-church" type="number" min="0" step="0.01"></label>
              <label>Rentenversicherung<input id="ps-rv" type="number" min="0" step="0.01"></label>
              <label>Arbeitslosenversicherung<input id="ps-av" type="number" min="0" step="0.01"></label>
              <label>Krankenversicherung<input id="ps-kv" type="number" min="0" step="0.01"></label>
              <label>Pflegeversicherung<input id="ps-pv" type="number" min="0" step="0.01"></label>
              <label>Firmenwagen Sachbezug<input id="ps-car" type="number" min="0" step="0.01"></label>
              <label>bAV Arbeitnehmer<input id="ps-bav" type="number" min="0" step="0.01"></label>
              <label>bAV Arbeitgeber<input id="ps-bav-ag" type="number" min="0" step="0.01"></label>
              <label>Bonus / Sonderzahlung<input id="ps-bonus" type="number" min="0" step="0.01"></label>
              <label>Notiz<input id="ps-note" maxlength="500"></label>
            </div>
            <button id="payslip-save" class="btn btn-primary" type="button">Speichern</button>
          </section>

          <section data-va-panel="contract" hidden>
            <p id="ct-review-hint" class="extended-note"></p>
            <div class="form-grid payslip-fields">
              <label>Gültig ab<input id="ct-from" type="date"></label>
              <label>Art<select id="ct-kind"><option value="contract">Arbeitsvertrag</option><option value="addendum">Nachtrag</option></select></label>
              <label>Bruttogehalt / Monat<input id="ct-gross" type="number" min="0" step="0.01"></label>
              <label>Wochenstunden<input id="ct-hours" type="number" min="0" max="80" step="0.5"></label>
              <label>Urlaubstage<input id="ct-vacation" type="number" min="0" max="100" step="0.5"></label>
              <label>bAV Arbeitgeberanteil / Monat<input id="ct-bav" type="number" min="0" step="0.01"></label>
              <label>Arbeitgeber<input id="ct-employer" maxlength="200"></label>
              <label>Position<input id="ct-position" maxlength="200"></label>
              <label>Kündigungsfrist<input id="ct-notice" maxlength="200"></label>
              <label class="check-row"><input id="ct-car" type="checkbox">Dienstwagen zur privaten Nutzung</label>
            </div>
            <div id="ct-extras" class="ct-extras"></div>
            <div class="ct-extra-actions"><button id="ct-add-extra" class="btn btn-secondary" type="button">Weiteres Feld</button></div>
            <button id="ct-save" class="btn btn-primary" type="button">Speichern</button>
          </section>
        </div>
      </dialog>

      <div id="comp-error" class="comp-toast" role="status" aria-live="polite"></div>
    </section>

