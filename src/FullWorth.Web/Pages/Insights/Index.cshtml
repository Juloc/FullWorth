@page "/insights"
@inject FullWorth.Web.Navigation.LocaleText Text
@{
    var language = FullWorth.Web.Navigation.LocaleText.Language(ViewContext.HttpContext);
    ViewData["Title"] = "Wichtig für dich · FullWorth";
    ViewData["ActiveView"] = "insights";
}

@*
    Eine eigene Seite (#154 Phase C): ihr Markup, ihr CSS, ihr JS - und nichts von den anderen.
    Das Markup stand bis hierher in wwwroot/pages/insights/page.html, von wo
    ops/generate-shell.mjs es in das eine grosse Dokument geschrieben hat.
*@

<section id="view-insights"><div id="insights-root"></div></section>

@section Styles {
    <link rel="stylesheet" href="~/styles/insights.css">
}

@section Scripts {
    <script type="module" src="~/pages/insights/entry.js"></script>
}
