@page "/transactions"
@inject FullWorth.Web.Navigation.LocaleText Text
@{
    var language = FullWorth.Web.Navigation.LocaleText.Language(ViewContext.HttpContext);
    ViewData["Title"] = "Buchungen · FullWorth";
    ViewData["ActiveView"] = "transactions";
}

@*
    Die erste echte Seite (#154 Phase B).

    Sie laedt ihr eigenes CSS und ihr eigenes JS - und sonst nichts. Kein Markup von Konten,
    Budgets, Vermoegen oder Einstellungen, keine 97 vorgeladenen Module. Das Markup stand bis
    hierher in wwwroot/pages/transactions/page.html, von wo ops/generate-shell.mjs es in das eine
    grosse Dokument geschrieben hat; jetzt steht es dort, wo die Seite ist.

    Die Ueberschrift kommt weiterhin aus den Sprachdateien und wird von entry.js gesetzt - eine
    serverseitige Uebersetzung ist nicht Teil dieses Schnitts.
*@

<section id="view-transactions"><div class="toolbar tx-toolbar"><button id="tx-back" type="button" class="btn btn-secondary tx-back" hidden aria-label="Zurück">←</button><label class="tx-search"><svg class="tx-search-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><use href="@IconSprite.Href(ViewContext.HttpContext, "ui-search")"></use></svg><input id="tx-query" type="search" data-i18n-placeholder="transactions.search" placeholder="@Text.Get("transactions.search", language)"></label><button id="tx-filter" type="button" class="tx-filter-btn"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="@IconSprite.Href(ViewContext.HttpContext, "ui-filter")"></use></svg><span data-i18n="common.filter">@Text.Get("common.filter", language)</span></button></div><div id="tx-transfer-hint" class="tx-transfer-hint" hidden></div><div id="tx-daybar" class="tx-daybar"><span id="tx-daybar-date" class="tx-daybar-date"></span><span id="tx-daybar-balance" class="tx-daybar-balance"></span><button id="tx-daybar-today" type="button" class="btn btn-secondary tx-daybar-today" data-i18n="common.today">@Text.Get("common.today", language)</button></div><article class="panel table-panel"><div class="tx-list"><div class="tx-list-head" aria-hidden="true"><span data-i18n="transactions.date">@Text.Get("transactions.date", language)</span><span data-i18n="transactions.counterparty">@Text.Get("transactions.counterparty", language)</span><span data-i18n="transactions.category">@Text.Get("transactions.category", language)</span><span data-i18n="transactions.account">@Text.Get("transactions.account", language)</span><span class="number" data-i18n="transactions.amount">@Text.Get("transactions.amount", language)</span><span></span></div><div id="transactions-body"></div></div></article><button id="tx-add" type="button" class="tx-fab" hidden aria-label="Buchung hinzufügen">+</button></section>

@section Styles {
    <link rel="stylesheet" href="~/pages/transactions/page.css">
}

@section Scripts {
    <script type="module" src="~/pages/transactions/entry.js"></script>
}
