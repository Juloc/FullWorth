@page "/categories"
@inject FullWorth.Web.Navigation.LocaleText Text
@{
    var language = FullWorth.Web.Navigation.LocaleText.Language(ViewContext.HttpContext);
    ViewData["Title"] = "Kategorien · FullWorth";
    ViewData["ActiveView"] = "categories";
}

@*
    Eine eigene Seite (#154 Phase C): ihr Markup, ihr CSS, ihr JS - und nichts von den anderen.
    Das Markup stand bis hierher in wwwroot/pages/categories/page.html, von wo
    ops/generate-shell.mjs es in das eine grosse Dokument geschrieben hat.
*@

<section id="view-categories"><article class="panel"><div class="panel-head"><h2 data-i18n="categories.title">@Text.Get("categories.title", language)</h2><div class="panel-head-actions"><label class="check inline"><input id="cat-archived" type="checkbox"><span data-i18n="categories.showArchived">@Text.Get("categories.showArchived", language)</span></label><button data-action="arrange-categories" data-i18n="categories.arrange">@Text.Get("categories.arrange", language)</button><button data-action="new-category" data-i18n="common.add">@Text.Get("common.add", language)</button></div></div><div id="categories-tree" class="cat-tree"></div></article></section>

@section Styles {
    <link rel="stylesheet" href="/pages/categories/page.css">
}

@section Scripts {
    <script type="module" src="/pages/categories/entry.js"></script>
}
