@*
    Die Seitenleiste und die untere Leiste - beide aus NavigationCatalog (#154).

    Zwei Darstellungen, eine Liste. Das war schon die Regel der alten Huelle; sie gilt hier weiter,
    nur dass die Liste jetzt serverseitig steht und das Markup im Request entsteht statt von
    ops/generate-shell.mjs in ein Dokument geschrieben zu werden.

    Der aktive Eintrag wird HIER gesetzt und nicht nachtraeglich per JavaScript: eine Navigation, die
    erst nach dem ersten Zeichnen ihre Markierung bekommt, ist genau der Sprung, den Frontend-Regel 1
    verbietet.
*@
@{
    var activeView = ViewData["ActiveView"] as string ?? string.Empty;
    var isAdmin = ViewData["IsAdmin"] as bool? ?? false;

    string ItemClass(string view) =>
        string.Equals(view, activeView, StringComparison.Ordinal) ? "nav-item active" : "nav-item";
}

<aside class="sidebar" aria-label="Primary">
    <div class="brand">
        <img class="brand-logo" src="/branding/fullworth-logo.svg" alt="" width="45" height="24">
        <span class="brand-name"><strong>FullWorth</strong><span class="brand-beta">Alpha</span></span>
        <button id="nav-collapse" class="icon-button nav-collapse" type="button" aria-label="Collapse navigation" title="Collapse">‹</button>
    </div>
    <nav id="nav" aria-label="Sections">
        @foreach (var group in NavigationCatalog.Groups)
        {
            <div class="nav-group" data-group="@group.Id">
                <button class="nav-group-head" type="button" data-group="@group.Id" aria-expanded="true">
                    <span data-i18n="@group.Label"></span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
                </button>
                <div class="nav-group-items">
                    @foreach (var entry in group.Items)
                    {
                        <a class="@ItemClass(entry.View)" href="@entry.Path" data-entry="@entry.View" data-view="@entry.View" hidden="@(entry.AdminOnly && !isAdmin)">
                            <svg viewBox="0 0 24 24" aria-hidden="true">@Html.Raw(entry.Icon)</svg>
                            <span data-i18n="@entry.Label"></span>
                        </a>
                    }
                </div>
            </div>
        }
        <script src="/app/nav-state.js"></script>
    </nav>
    <div class="sidebar-foot">
        <div class="sidebar-user">
            <span class="sidebar-avatar" id="user-avatar" aria-hidden="true">F</span>
            <div class="sidebar-user-meta">
                <div class="sidebar-user-name" id="user-space-name"></div>
                <div class="sidebar-user-sub" id="user-space-sub"></div>
            </div>
            <button id="theme-toggle" class="icon-button theme-toggle" type="button" data-theme-pref="system" data-i18n-title="settings.toggleTheme" title="Hell/Dunkel umschalten" aria-label="Theme">
                <svg data-theme-icon="system" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
                <svg data-theme-icon="light" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                <svg data-theme-icon="dark" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
            </button>
        </div>
    </div>
</aside>
