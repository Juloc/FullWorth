@*
    Die Aktionsleiste einer Seite. Die Seite bindet sie in ihrem Abschnitt "Actions" ein:

        @section Actions { <partial name="_ActionBar" /> }

    Hauptaktion, weitere Aktionen und die Aktionen einer Auswahl befuellt die Seite selbst
    (components/action-bar.js). Die Huelle kennt die Leiste nicht.
*@
<div id="action-bar" class="action-bar">
    <div id="action-bar-selection" class="action-bar-selection"></div>
    <div id="action-bar-extra" class="action-bar-extra"></div>
    <button id="primary-action" class="btn btn-primary" type="button" hidden></button>
</div>
