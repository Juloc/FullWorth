@*
    Die untere Leiste am Telefon: vier Schnellziele und "Mehr". Dieselbe Liste wie die Seitenleiste,
    nur anders dargestellt - die vier stehen in NavigationCatalog.Quick, alles Weitere hinter "Mehr",
    und dort stehen diese vier ebenfalls. Eine Abkuerzung, keine Auswahl.
*@
@inject FullWorth.Web.Navigation.LocaleText Text
@{
    var activeView = ViewData["ActiveView"] as string ?? string.Empty;
    var language = FullWorth.Web.Navigation.LocaleText.Language(ViewContext.HttpContext);
    var byView = NavigationCatalog.Entries.ToDictionary(entry => entry.View, StringComparer.Ordinal);
}

<nav id="bottom-nav" aria-label="Primary mobile">
    @foreach (var view in NavigationCatalog.Quick)
    {
        var entry = byView[view];
        <a class="@(string.Equals(view, activeView, StringComparison.Ordinal) ? "nav-item active" : "nav-item")" href="@entry.Path" data-entry="@entry.View" data-view="@entry.View" aria-current="@(string.Equals(view, activeView, StringComparison.Ordinal) ? "page" : null)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><use href="@IconSprite.Href(ViewContext.HttpContext, entry.Icon)"></use></svg>
            <span data-i18n="@entry.Label">@Text.Get(entry.Label, language)</span>
        </a>
    }
    <button id="bottom-more" class="nav-item" type="button">
        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="@IconSprite.Href(ViewContext.HttpContext, "nav-more")"></use></svg>
        <span data-i18n="nav.more">@Text.Get("nav.more", language)</span>
    </button>
</nav>
