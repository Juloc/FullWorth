@page "/purchases"
@inject FullWorth.Web.Navigation.LocaleText Text
@{
    var language = FullWorth.Web.Navigation.LocaleText.Language(ViewContext.HttpContext);
    ViewData["Title"] = "Käufe · FullWorth";
    ViewData["ActiveView"] = "purchases";
}

@*
    Eine eigene Seite (#154 Phase C): ihr Markup, ihr CSS, ihr JS - und nichts von den anderen.
    Das Markup stand bis hierher in wwwroot/pages/purchases/page.html, von wo
    ops/generate-shell.mjs es in das eine grosse Dokument geschrieben hat.
*@

<section id="view-purchases"><div class="toolbar"><select id="purchase-source" aria-label="Source"><option value="" data-i18n="common.all">@Text.Get("common.all", language)</option><option value="receipt" data-i18n="purchases.receipt">@Text.Get("purchases.receipt", language)</option><option value="amazon">Amazon</option></select><button id="scan-receipt" data-i18n="purchases.scan">@Text.Get("purchases.scan", language)</button><button id="amazon-import" data-i18n="purchases.amazonImport">@Text.Get("purchases.amazonImport", language)</button><input id="receipt-file" type="file" accept="image/*,.pdf" capture="environment" hidden></div><article class="panel"><div class="panel-head"><h2 data-i18n="purchases.title">@Text.Get("purchases.title", language)</h2></div><div id="purchases-list" class="rows"></div></article></section>

@section Styles {
    <link rel="stylesheet" href="/pages/purchases/page.css">
}

@section Scripts {
    <script type="module" src="/pages/purchases/entry.js"></script>
}
