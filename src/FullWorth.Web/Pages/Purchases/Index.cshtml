@page "/purchases"
@inject FullWorth.Web.Navigation.LocaleText Text
@{
    var language = FullWorth.Web.Navigation.LocaleText.Language(ViewContext.HttpContext);
    ViewData["Title"] = "Käufe · FullWorth";
    ViewData["ActiveView"] = "purchases";
}

@*
    Eine eigene Seite (#154 Phase C): ihr Markup, ihr CSS, ihr JS - und nichts von den anderen.
    Das Markup stand bis hierher in wwwroot/pages/purchases/page.html, von wo
    ops/generate-shell.mjs es in das eine grosse Dokument geschrieben hat.
*@

<section id="view-purchases"><div class="toolbar"><select id="purchase-source"><option value="" data-i18n="purchases.allSources">@Text.Get("purchases.allSources", language)</option><option value="receipt" data-i18n="purchases.receipt">@Text.Get("purchases.receipt", language)</option><option value="amazon">Amazon</option></select><select id="purchase-scope"><option value="" data-i18n="purchases.allPurchases">@Text.Get("purchases.allPurchases", language)</option><option value="review" data-i18n="purchases.needsReview">@Text.Get("purchases.needsReview", language)</option><option value="unlinked" data-i18n="purchases.unlinked">@Text.Get("purchases.unlinked", language)</option></select></div><article class="panel dt-card"><div id="purchases-list" class="dt"></div><div id="purchases-sentinel"></div></article></section>

@section Actions {
    <partial name="_ActionBar" />
}

@section Styles {
    <link rel="stylesheet" href="~/styles/data-table.css">
    <link rel="stylesheet" href="~/styles/document-viewer.css">
    <link rel="stylesheet" href="~/pages/purchases/page.css">
}

@section Scripts {
    <script type="module" src="~/pages/purchases/entry.js"></script>
}
