@page "/budgets"
@inject FullWorth.Web.Navigation.LocaleText Text
@{
    var language = FullWorth.Web.Navigation.LocaleText.Language(ViewContext.HttpContext);
    ViewData["Title"] = "Budgets · FullWorth";
    ViewData["ActiveView"] = "budgets";
}

@*
    Eine eigene Seite (#154 Phase C): ihr Markup, ihr CSS, ihr JS - und nichts von den anderen.
    Das Markup stand bis hierher in wwwroot/pages/budgets/page.html, von wo
    ops/generate-shell.mjs es in das eine grosse Dokument geschrieben hat.
*@

<section id="view-budgets"><div class="metric-grid"><article class="metric"><span data-i18n="budgets.totalBudgeted">@Text.Get("budgets.totalBudgeted", language)</span><strong id="budget-total">—</strong></article><article class="metric"><span data-i18n="budgets.spent">@Text.Get("budgets.spent", language)</span><strong id="budget-spent">—</strong></article><article class="metric"><span data-i18n="budgets.remaining">@Text.Get("budgets.remaining", language)</span><strong id="budget-remaining">—</strong></article></div><article class="panel"><div class="panel-head"><h2 data-i18n="budgets.title">@Text.Get("budgets.title", language)</h2><button data-action="budget-groups" data-i18n="accounts.groups">@Text.Get("accounts.groups", language)</button><button data-action="new-budget" data-i18n="common.add">@Text.Get("common.add", language)</button></div><div id="budgets-list" class="budget-cards"></div></article></section>

@section Styles {
    <link rel="stylesheet" href="~/pages/budgets/page.css">
}

@section Scripts {
    <script type="module" src="~/pages/budgets/entry.js"></script>
}
