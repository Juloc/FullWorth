@page "/analytics"
@inject FullWorth.Web.Navigation.LocaleText Text
@{
    var language = FullWorth.Web.Navigation.LocaleText.Language(ViewContext.HttpContext);
    ViewData["Title"] = "Analyse · FullWorth";
    ViewData["ActiveView"] = "analytics";
}

@*
    Eine eigene Seite (#154 Phase C): ihr Markup, ihr CSS, ihr JS - und nichts von den anderen.
    Das Markup stand bis hierher in wwwroot/pages/analytics/page.html, von wo
    ops/generate-shell.mjs es in das eine grosse Dokument geschrieben hat.
*@

<section id="view-analytics"><div class="toolbar an-toolbar"><label class="field"><span data-i18n="analytics.period">@Text.Get("analytics.period", language)</span><select id="an-period"><option value="7d" data-i18n="analytics.period_7d">@Text.Get("analytics.period_7d", language)</option><option value="month" selected data-i18n="analytics.period_month">@Text.Get("analytics.period_month", language)</option><option value="quarter" data-i18n="analytics.period_quarter">@Text.Get("analytics.period_quarter", language)</option><option value="year" data-i18n="analytics.period_year">@Text.Get("analytics.period_year", language)</option><option value="1y" data-i18n="analytics.period_1y">@Text.Get("analytics.period_1y", language)</option><option value="5y" data-i18n="analytics.period_5y">@Text.Get("analytics.period_5y", language)</option><option value="all" data-i18n="analytics.period_all">@Text.Get("analytics.period_all", language)</option></select></label></div><div class="metric-grid"><article class="metric"><span data-i18n="transactions.income">@Text.Get("transactions.income", language)</span><strong id="an-income">—</strong></article><article class="metric"><span data-i18n="transactions.expenses">@Text.Get("transactions.expenses", language)</span><strong id="an-expenses">—</strong></article><article class="metric"><span data-i18n="analytics.net">@Text.Get("analytics.net", language)</span><strong id="an-net">—</strong></article></div><div class="content-grid"><article class="panel span-2" id="an-builder"><div class="panel-head"><h2 data-i18n="analytics.builder.title">@Text.Get("analytics.builder.title", language)</h2><div class="panel-head-actions"><button id="an-save" class="btn btn-secondary" data-i18n="analytics.builder.save">@Text.Get("analytics.builder.save", language)</button><button id="an-run" data-i18n="analytics.builder.run">@Text.Get("analytics.builder.run", language)</button></div></div><div class="toolbar an-toolbar"><label class="field"><span data-i18n="analytics.builder.measure">@Text.Get("analytics.builder.measure", language)</span><select id="an-measure"><option value="spend" data-i18n="analytics.builder.measure_spend">@Text.Get("analytics.builder.measure_spend", language)</option><option value="income" data-i18n="analytics.builder.measure_income">@Text.Get("analytics.builder.measure_income", language)</option><option value="net" data-i18n="analytics.builder.measure_net">@Text.Get("analytics.builder.measure_net", language)</option><option value="count" data-i18n="analytics.builder.measure_count">@Text.Get("analytics.builder.measure_count", language)</option></select></label><label class="field"><span data-i18n="analytics.builder.dimension">@Text.Get("analytics.builder.dimension", language)</span><select id="an-dimension"><option value="month" data-i18n="analytics.builder.dimension_month">@Text.Get("analytics.builder.dimension_month", language)</option><option value="category" data-i18n="analytics.builder.dimension_category">@Text.Get("analytics.builder.dimension_category", language)</option><option value="merchant" data-i18n="analytics.builder.dimension_merchant">@Text.Get("analytics.builder.dimension_merchant", language)</option><option value="none" data-i18n="analytics.builder.dimension_none">@Text.Get("analytics.builder.dimension_none", language)</option></select></label><label class="field"><span data-i18n="analytics.period">@Text.Get("analytics.period", language)</span><select id="an-cperiod"><option value="7d" data-i18n="analytics.period_7d">@Text.Get("analytics.period_7d", language)</option><option value="month" data-i18n="analytics.period_month">@Text.Get("analytics.period_month", language)</option><option value="quarter" data-i18n="analytics.period_quarter">@Text.Get("analytics.period_quarter", language)</option><option value="year" data-i18n="analytics.period_year">@Text.Get("analytics.period_year", language)</option><option value="1y" selected data-i18n="analytics.period_1y">@Text.Get("analytics.period_1y", language)</option><option value="5y" data-i18n="analytics.period_5y">@Text.Get("analytics.period_5y", language)</option><option value="all" data-i18n="analytics.period_all">@Text.Get("analytics.period_all", language)</option></select></label><label class="field"><span data-i18n="analytics.builder.type">@Text.Get("analytics.builder.type", language)</span><select id="an-ctype"><option value="bar" data-i18n="analytics.builder.type_bar">@Text.Get("analytics.builder.type_bar", language)</option><option value="line" data-i18n="analytics.builder.type_line">@Text.Get("analytics.builder.type_line", language)</option><option value="hbar" data-i18n="analytics.builder.type_hbar">@Text.Get("analytics.builder.type_hbar", language)</option><option value="donut" data-i18n="analytics.builder.type_donut">@Text.Get("analytics.builder.type_donut", language)</option></select></label></div><div id="an-builder-chart" class="chart-empty"></div><div id="an-saved" class="rows"></div></article><article class="panel span-2"><h2 data-i18n="analytics.incomeExpense">@Text.Get("analytics.incomeExpense", language)</h2><div id="an-monthly" class="chart-empty"></div></article><article class="panel span-2"><h2 data-i18n="analytics.trend">@Text.Get("analytics.trend", language)</h2><div id="trend-chart" class="chart-empty"></div></article><article class="panel"><h2 data-i18n="analytics.categories">@Text.Get("analytics.categories", language)</h2><div id="category-analysis" class="rows"></div></article><article class="panel"><h2 data-i18n="analytics.merchants">@Text.Get("analytics.merchants", language)</h2><div id="merchant-analysis" class="rows"></div></article><article class="panel"><h2 data-i18n="analytics.forecast">@Text.Get("analytics.forecast", language)</h2><div id="forecast-list" class="rows"></div></article></div></section>

@section Styles {
    <link rel="stylesheet" href="/pages/analytics/page.css">
}

@section Scripts {
    <script type="module" src="/pages/analytics/entry.js"></script>
}
