@page "/receipts"
@inject FullWorth.Web.Navigation.LocaleText Text
@{
    var language = FullWorth.Web.Navigation.LocaleText.Language(ViewContext.HttpContext);
    ViewData["Title"] = "Belege · FullWorth";
    ViewData["ActiveView"] = "receipts";
}

@*
    Die Belege-Seite: was der Server gerade liest (Warteschlange), was er gelesen hat (Verlauf) und
    was noch ein Mensch ansehen muss (Zu pruefen). Der Platz fuer Zaehler und Liste steht von Anfang an
    im Dokument - die Zahlen kommen spaeter, die Hoehe nicht.
*@

<section id="view-receipts">
        <div class="fw-cycle">
            <button type="button" data-receipts-tab="queue"><span data-i18n="receipts.queue">@Text.Get("receipts.queue", language)</span> <span class="receipts-count is-pending" data-count="queue">0</span></button>
            <button type="button" data-receipts-tab="history" data-i18n="receipts.history">@Text.Get("receipts.history", language)</button>
            <button type="button" data-receipts-tab="review"><span data-i18n="receipts.review">@Text.Get("receipts.review", language)</span> <span class="receipts-count is-pending" data-count="needsReview">0</span></button>
            <button type="button" data-receipts-tab="failed"><span data-i18n="receipts.failed">@Text.Get("receipts.failed", language)</span> <span class="receipts-count is-pending" data-count="failed">0</span></button>
        </div>
    <article class="panel dt-card">
        <div id="receipts-list" class="dt"></div>
        <div id="receipts-sentinel"></div>
    </article>
    <input id="receipts-file" type="file" accept="image/*,.pdf" multiple hidden>
</section>

@section Actions {
    <partial name="_ActionBar" />
}

@section Styles {
    <link rel="stylesheet" href="~/styles/data-table.css">
    <link rel="stylesheet" href="~/pages/receipts/page.css">
}

@section Scripts {
    <script type="module" src="~/pages/receipts/entry.js"></script>
}
