@page "/settings/intelligence"
@inject FullWorth.Web.Navigation.LocaleText Text
@{
    var language = FullWorth.Web.Navigation.LocaleText.Language(ViewContext.HttpContext);
    ViewData["Title"] = "AI & Intelligence · FullWorth";
    ViewData["ActiveView"] = "intelligence";
}

@*
    Eine eigene Seite (#154 Phase C): ihr Markup, ihr CSS, ihr JS - und nichts von den anderen.
    Das Markup stand bis hierher in wwwroot/pages/settings/intelligence/page.html, von wo
    ops/generate-shell.mjs es in das eine grosse Dokument geschrieben hat.
*@

<section id="view-intelligence" class="intel-view">
      <div class="intel-state"><span id="intel-status" class="status-pill">Lädt…</span></div>
      <div id="intel-denied" class="panel intel-message" hidden>
        <h2>Nicht verfügbar</h2>
        <p>Diese Seite ist nur für Instanz-Administratoren verfügbar.</p>
      </div>

      <div id="intel-content" hidden>
        <section class="panel brand-pack-panel">
          <div class="panel-head">
            <div>
              <h2>Eigene Brand-Packs</h2>
              <p class="row-sub">Eigene Logos und Firmen-Aliase bleiben auf dieser Instanz und überschreiben bei Treffern den mitgelieferten Katalog.</p>
            </div>
            <button id="brand-pack-refresh" type="button" class="btn btn-secondary">Aktualisieren</button>
          </div>
          <div class="brand-pack-import">
            <input id="brand-pack-file" type="file" accept=".json,application/json">
            <button id="brand-pack-import" type="button">Pack importieren</button>
          </div>
          <details class="intel-details brand-pack-format">
            <summary>Pack-Format</summary>
            <pre class="intel-code">{
        "name": "Meine Firmenlogos",
        "version": "1.0",
        "priority": 2000,
        "enabled": true,
        "assets": [{
      "brandKey": "meine-firma",
      "canonicalName": "Meine Firma",
      "mediaType": "image/svg+xml",
      "contentBase64": "PHN2ZyB4bWxucz0i..."
        }],
        "aliases": [{
      "aliasKey": "MEINE FIRMA GMBH",
      "brandKey": "meine-firma",
      "country": "DE"
        }]
      }</pre>
            <p class="row-sub">SVGs werden lokal auf Hash, Größe und aktive Inhalte geprüft. Identische SVGs werden nur einmal im gemeinsamen Content-Cache gespeichert. Ein erneuter Import mit demselben Pack-Namen aktualisiert das vorhandene Pack.</p>
          </details>
          <p id="brand-pack-result" class="intel-result" aria-live="polite"></p>
          <div id="brand-pack-list" class="rows"></div>
        </section>

        @* Eigenes Panel und nicht bei den KI-Schaltern: diese Sprosse braucht keinen Zugang und
           kostet keine Tokens. Sie kostet etwas anderes, und das steht daneben. *@
        <section class="panel">
          <div class="panel-head">
            <div>
              <h2>Logos nachschlagen</h2>
              <p class="row-sub">FullWorth sucht ein Logo zuerst im mitgelieferten Katalog und rechnet den Markennamen selbst aus. Findet es dort nichts, kann es beim Simple-Icons-Spiegel nachfragen.</p>
            </div>
          </div>
          <label class="check"><input id="brand-cdn-lookup" type="checkbox"><span>Beim Simple-Icons-Spiegel nachschlagen</span></label>
          <p class="row-sub">Dabei verlässt der ausgerechnete Markenname diese Maschine: aus <em>REWE SAGT DANKE</em> wird <em>rewe</em>, aus <em>MUELLER FLIESENLEGER</em> aber <em>muellerfliesenleger</em>. Die abgerufene Adresse <em>ist</em> der Name – ein Logo lässt sich nicht holen, ohne zu sagen, wessen Logo. Es geht nur der Name, kein Betrag, kein Datum und keine Kennung, und was schon im Abbild liegt, wird nie nachgeschlagen.</p>
          <p id="brand-cdn-result" class="intel-result" aria-live="polite"></p>
        </section>

        <section class="intel-metrics">
          <article class="metric"><span>Provider</span><strong id="metric-provider">—</strong></article>
          <article class="metric"><span>Offene Vorschläge</span><strong id="metric-suggestions">—</strong></article>
          <article class="metric"><span>Fehlgeschlagene Jobs</span><strong id="metric-failed">—</strong></article>
          <article class="metric"><span>Kosten Monat</span><strong id="metric-cost">—</strong></article>
        </section>

        <section class="panel">
          <div class="panel-head"><h2>Provider & Modelle</h2><button id="save-settings" class="btn btn-primary" type="button">Speichern</button></div>
          <div class="intel-form-grid">
            <label class="check"><input id="ai-enabled" type="checkbox"><span>AI aktivieren</span></label>
            <label><span>Provider</span><select id="ai-provider"></select></label>
            <label><span>Credential</span><select id="ai-credential"><option value="">Keins</option></select></label>
            <label><span>Textmodell</span><input id="ai-text-model" autocomplete="off"></label>
            <label><span>Vision-Modell</span><input id="ai-vision-model" autocomplete="off"></label>
            <label><span>Tagesbudget €</span><input id="ai-daily-budget" type="number" min="0" step="0.01"></label>
            <label><span>Monatsbudget €</span><input id="ai-monthly-budget" type="number" min="0" step="0.01"></label>
            <label class="check"><input id="ai-allow-user-credentials" type="checkbox"><span>Eigene User-Credentials erlauben</span></label>
          </div>
          <!-- Wofür dieser Zugang arbeiten darf. Die Liste kommt vom Server (availableModules), damit
               ein neues Modul hier nicht noch einmal von Hand gepflegt werden muss. -->
          <div class="intel-feature-grid" id="ai-modules"></div>
          <div class="intel-feature-grid">
            <label class="check"><input id="ai-daily" type="checkbox"><span>Daily Scan</span></label>
            <label class="check"><input id="ai-weekly" type="checkbox"><span>Weekly Deep Scan</span></label>
            <label class="check"><input id="ai-monthly" type="checkbox"><span>Monthly Review</span></label>
          </div>
          <p class="row-sub">Wenn ein Budget gesetzt ist, muss für das gewählte Modell eine konservative Kostenschätzung konfiguriert sein. Sonst werden Provider-Aufrufe sicher zurückgestellt.</p>
          <p id="settings-result" class="intel-result" aria-live="polite"></p>
        </section>

        <section class="panel">
          <div class="panel-head"><div><h2>Offene Vorschläge</h2><p class="row-sub">AI-Vorschläge ändern nichts automatisch. Erst deine Bestätigung erzeugt ein lokales Mapping.</p></div><button id="refresh-suggestions" type="button">Aktualisieren</button></div>
          <div id="suggestion-list" class="rows"></div>
        </section>

        <section class="panel">
          <div class="panel-head"><div><h2>Scheduled Jobs</h2><p class="row-sub">Zeigt auch bewusst zurückgestellte Jobs, z. B. wegen Budget oder fehlendem Credential.</p></div><button id="refresh-jobs" type="button">Aktualisieren</button></div>
          <div id="job-list" class="rows"></div>
        </section>

        <section class="panel">
          <div class="panel-head"><h2>Credentials</h2></div>
          <form id="credential-form" class="intel-inline-form">
            <select id="credential-provider" aria-label="Provider"></select>
            <input id="credential-name" maxlength="120" placeholder="Name" required>
            <input id="credential-secret" type="password" autocomplete="new-password" placeholder="API Key" required>
            <button type="submit">Hinzufügen</button>
          </form>
          <p class="row-sub">Der vollständige Key wird nach dem Speichern nicht mehr an den Browser zurückgegeben.</p>
          <div id="credential-list" class="rows"></div>
        </section>

        <section class="panel">
          <div class="panel-head"><h2>Provider Smoke Test</h2><button id="run-smoke" type="button">Test ausführen</button></div>
          <p class="row-sub">Sendet ausschließlich feste synthetische Testdaten. Keine Konten, Transaktionen oder Belege.</p>
          <pre id="smoke-result" class="intel-code">Noch nicht ausgeführt.</pre>
        </section>

        <section class="panel">
          <div class="panel-head"><h2>Zusammenfassungen</h2></div>
          <p class="row-sub">Was die geplanten Läufe erbracht haben - je Woche und je Monat, mit den Kosten.</p>
          <div id="digest-list" class="rows"></div>
        </section>

        <div class="intel-two-col">
          <section class="panel"><div class="panel-head"><h2>Letzte AI-Runs</h2></div><div id="run-list" class="rows"></div></section>
          <section class="panel"><div class="panel-head"><h2>Intelligence Audit</h2></div><div id="audit-list" class="rows"></div></section>
        </div>
      </div>
    </section>

@section Styles {
    <link rel="stylesheet" href="~/pages/settings/intelligence/page.css">
}

@section Scripts {
    <script type="module" src="~/pages/settings/intelligence/entry.js"></script>
}
