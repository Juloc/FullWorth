@page "/settings/security/passkeys"
@inject FullWorth.Web.Navigation.LocaleText Text
@{
    var language = FullWorth.Web.Navigation.LocaleText.Language(ViewContext.HttpContext);
    ViewData["Title"] = "Passkeys · FullWorth";
    ViewData["ActiveView"] = "passkeys";
}

@*
    Eine eigene Seite (#154 Phase C): ihr Markup, ihr CSS, ihr JS - und nichts von den anderen.
    Das Markup stand bis hierher in wwwroot/pages/settings/security/passkeys/page.html, von wo
    ops/generate-shell.mjs es in das eine grosse Dokument geschrieben hat.
*@

<section id="view-passkeys">
      <article class="panel">
        <div class="panel-head"><h2 data-i18n="passkeys.add"></h2></div>
        <p class="row-sub panel-intro" data-i18n="passkeys.explanation"></p>
        <div class="settings-grid">
          <label for="passkey-name">
            <span data-i18n="passkeys.name"></span>
            <input id="passkey-name" type="text" maxlength="80" autocomplete="off" data-i18n-placeholder="passkeys.namePlaceholder">
          </label>
          <button type="button" class="btn btn-primary" data-passkey-action="add" data-i18n="passkeys.add"></button>
        </div>
      </article>

      <!-- visibility statt hidden: die Meldung erscheint nach einer Eingabe, und ein Kasten, der
           dabei erst entsteht, schiebt die Liste darunter nach unten. -->
      <div id="passkey-management-status" class="passkey-status" role="status" aria-live="polite"></div>

      <article class="panel">
        <div class="panel-head"><h2 data-i18n="passkeys.yourPasskeys"></h2></div>
        <div id="passkey-list" class="passkey-list rows" aria-live="polite"></div>
      </article>
    </section>

@section Styles {
    <link rel="stylesheet" href="~/pages/settings/security/passkeys/page.css">
}

@section Scripts {
    <script type="module" src="~/pages/settings/security/passkeys/entry.js"></script>
}
