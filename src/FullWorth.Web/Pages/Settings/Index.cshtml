@page "/settings"
@inject FullWorth.Web.Navigation.LocaleText Text
@{
    var language = FullWorth.Web.Navigation.LocaleText.Language(ViewContext.HttpContext);
    ViewData["Title"] = "Einstellungen · FullWorth";
    ViewData["ActiveView"] = "settings";
}

@*
    Eine eigene Seite (#154 Phase C): ihr Markup, ihr CSS, ihr JS - und nichts von den anderen.
    Das Markup stand bis hierher in wwwroot/pages/settings/page.html, von wo
    ops/generate-shell.mjs es in das eine grosse Dokument geschrieben hat.
*@

<section id="view-settings"><article class="panel"><div class="panel-head"><h2 data-i18n="settings.appearance">@Text.Get("settings.appearance", language)</h2></div><div class="settings-grid"><label><span data-i18n="settings.language">@Text.Get("settings.language", language)</span><select id="language"><option value="de">Deutsch</option><option value="en">English</option></select></label><label><span data-i18n="settings.theme">@Text.Get("settings.theme", language)</span><select id="theme"><option value="system" data-i18n="theme.system">@Text.Get("theme.system", language)</option><option value="light" data-i18n="theme.light">@Text.Get("theme.light", language)</option><option value="dark" data-i18n="theme.dark">@Text.Get("theme.dark", language)</option></select></label><div class="appearance-panel"><div class="appearance-color-row"><label class="appearance-color-field"><span data-i18n="settings.colorSeed">@Text.Get("settings.colorSeed", language)</span><input id="appearance-seed" type="color" value="#2f6f4f"></label><button id="appearance-seed-reset" type="button" class="btn btn-quiet" data-i18n="settings.colorReset">@Text.Get("settings.colorReset", language)</button></div><p class="row-sub" data-i18n="settings.colorSeedHint">@Text.Get("settings.colorSeedHint", language)</p><p class="row-sub" data-i18n="settings.presets">@Text.Get("settings.presets", language)</p><div class="appearance-presets" role="group" aria-label="Schnellwahl"><button type="button" class="appearance-preset" data-appearance-preset="white" aria-pressed="false"><span class="sr-only" data-i18n="settings.presetWhite">@Text.Get("settings.presetWhite", language)</span></button><button type="button" class="appearance-preset" data-appearance-preset="grey" aria-pressed="false"><span class="sr-only" data-i18n="settings.presetGrey">@Text.Get("settings.presetGrey", language)</span></button><button type="button" class="appearance-preset" data-appearance-preset="black" aria-pressed="false"><span class="sr-only" data-i18n="settings.presetBlack">@Text.Get("settings.presetBlack", language)</span></button><button type="button" class="appearance-preset" data-appearance-preset="blue" aria-pressed="false"><span class="sr-only" data-i18n="settings.presetBlue">@Text.Get("settings.presetBlue", language)</span></button><button type="button" class="appearance-preset" data-appearance-preset="purple" aria-pressed="false"><span class="sr-only" data-i18n="settings.presetPurple">@Text.Get("settings.presetPurple", language)</span></button><button type="button" class="appearance-preset" data-appearance-preset="green" aria-pressed="false"><span class="sr-only" data-i18n="settings.presetGreen">@Text.Get("settings.presetGreen", language)</span></button></div><label class="fw-toggle-row appearance-logo-row"><span data-i18n="settings.logoMode">@Text.Get("settings.logoMode", language)</span><span class="fw-toggle"><input id="appearance-logo-mode" type="checkbox"><span class="fw-toggle-track"></span></span></label><p class="row-sub" data-i18n="settings.livePreview">@Text.Get("settings.livePreview", language)</p><div class="appearance-preview"><div class="appearance-preview-card"><p class="appearance-preview-heading">Aa</p><p class="appearance-preview-muted" data-i18n="settings.previewMuted">@Text.Get("settings.previewMuted", language)</p><div class="appearance-preview-actions"><button type="button" class="btn btn-primary" tabindex="-1" data-i18n="settings.previewPrimary">@Text.Get("settings.previewPrimary", language)</button><button type="button" class="btn btn-secondary" tabindex="-1" data-i18n="settings.previewSecondary">@Text.Get("settings.previewSecondary", language)</button><a href="#" class="appearance-preview-link" tabindex="-1" data-i18n="settings.previewLink">@Text.Get("settings.previewLink", language)</a></div><button type="button" class="btn btn-danger" tabindex="-1" data-i18n="settings.previewDanger">@Text.Get("settings.previewDanger", language)</button></div><svg class="appearance-preview-chart" viewBox="0 0 220 64" aria-hidden="true" focusable="false"><rect x="4" y="38" width="12" height="22"></rect><rect x="22" y="26" width="12" height="34"></rect><rect x="40" y="32" width="12" height="28"></rect><rect x="58" y="20" width="12" height="40"></rect><rect x="76" y="30" width="12" height="30"></rect><rect x="94" y="24" width="12" height="36"></rect><defs><linearGradient id="appearance-preview-gradient" x1="0" y1="0" x2="0" y2="1"><stop offset="0"></stop><stop offset="1"></stop></linearGradient></defs><path d="M120 40 L135 30 L150 36 L165 18 L180 26 L195 14 L210 22 L210 60 L120 60 Z" fill="url(#appearance-preview-gradient)"></path><path class="appearance-preview-line" d="M120 40 L135 30 L150 36 L165 18 L180 26 L195 14 L210 22" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></div></div><label class="fw-toggle-row settings-toggle"><span data-i18n="privacy.rememberOn">@Text.Get("privacy.rememberOn", language)</span><span class="fw-toggle"><input id="privacy-default" type="checkbox"><span class="fw-toggle-track"></span></span></label><label class="fw-toggle-row settings-toggle"><span data-i18n="coach.bubble">@Text.Get("coach.bubble", language)</span><span class="fw-toggle"><input id="coach-quick-access" type="checkbox"><span class="fw-toggle-track"></span></span></label><div class="settings-layout-reset-row"><button id="layout-reset" type="button" class="btn btn-secondary" data-i18n="settings.layoutReset">@Text.Get("settings.layoutReset", language)</button><small id="layout-reset-hint" data-i18n="settings.layoutResetHint">@Text.Get("settings.layoutResetHint", language)</small></div></div></article><article class="panel"><div class="panel-head"><h2 data-i18n="settings.security">@Text.Get("settings.security", language)</h2></div><div class="rows"><button id="admin-settings-link" type="button" class="row settings-link" hidden><div class="row-main"><div class="row-title">Admin</div><div class="row-sub">User verwalten</div></div><span aria-hidden="true">›</span></button><button id="two-factor-settings" type="button" class="row settings-link"><div class="row-main"><div class="row-title" data-i18n="twoFactor.title">@Text.Get("twoFactor.title", language)</div><div class="row-sub" data-i18n="twoFactor.hint">@Text.Get("twoFactor.hint", language)</div></div><span aria-hidden="true">›</span></button><a class="row settings-link" data-view-jump="passkeys" href="/settings/security/passkeys"><div class="row-main"><div class="row-title" data-i18n="passkeys.title">@Text.Get("passkeys.title", language)</div><div class="row-sub" data-i18n="settings.passkeysHint">@Text.Get("settings.passkeysHint", language)</div></div><span aria-hidden="true">›</span></a><button id="lock-settings" type="button" class="row settings-link"><div class="row-main"><div class="row-title" data-i18n="lock.pinSettingsTitle">@Text.Get("lock.pinSettingsTitle", language)</div><div class="row-sub" data-i18n="settings.lockHint">@Text.Get("settings.lockHint", language)</div></div><span aria-hidden="true">›</span></button></div></article><article class="panel"><div class="panel-head"><h2 data-i18n="bankingSetup.title">@Text.Get("bankingSetup.title", language)</h2></div><div class="rows"><a class="row settings-link" data-view-jump="bank-connections" href="/settings/bank-connections"><div class="row-main"><div class="row-title" data-i18n="settings.bankConnections">@Text.Get("settings.bankConnections", language)</div><div class="row-sub" data-i18n="settings.bankConnectionsHint">@Text.Get("settings.bankConnectionsHint", language)</div></div><span aria-hidden="true">›</span></a><button id="enable-banking-settings" type="button" class="row settings-link"><div class="row-main"><div class="row-title" data-i18n="bankingSetup.manage">@Text.Get("bankingSetup.manage", language)</div><div id="enable-banking-status" class="row-sub" data-i18n="bankingSetup.loading">@Text.Get("bankingSetup.loading", language)</div></div><span aria-hidden="true">›</span></button></div></article><article class="panel"><div class="panel-head"><h2 data-i18n="aiAccess.title">@Text.Get("aiAccess.title", language)</h2></div><div class="rows"><button id="ai-access-settings" type="button" class="row settings-link"><div class="row-main"><div class="row-title" data-i18n="aiAccess.manage">@Text.Get("aiAccess.manage", language)</div><div id="ai-access-status" class="row-sub" data-i18n="aiAccess.loading">@Text.Get("aiAccess.loading", language)</div></div><span aria-hidden="true">›</span></button></div></article><article id="cloud-intelligence-panel" class="panel" hidden><div class="panel-head"><h2 data-i18n="cloudIntelligence.title">@Text.Get("cloudIntelligence.title", language)</h2></div><div class="rows"><button id="cloud-intelligence-settings" type="button" class="row settings-link"><div class="row-main"><div class="row-title" data-i18n="cloudIntelligence.manage">@Text.Get("cloudIntelligence.manage", language)</div><div id="cloud-intelligence-status" class="row-sub" data-i18n="cloudIntelligence.loading">@Text.Get("cloudIntelligence.loading", language)</div></div><span aria-hidden="true">›</span></button></div></article><article class="panel"><div class="panel-head"><h2 data-i18n="settings.account">@Text.Get("settings.account", language)</h2></div><div class="rows"><button id="delete-account" type="button" class="row settings-link"><div class="row-main"><div class="row-title" data-i18n="settings.deleteAccount">@Text.Get("settings.deleteAccount", language)</div><div class="row-sub" data-i18n="settings.deleteAccountHint">@Text.Get("settings.deleteAccountHint", language)</div></div><span aria-hidden="true">›</span></button></div></article><article class="panel"><div class="panel-head"><h2 data-i18n="settings.data">@Text.Get("settings.data", language)</h2></div><div class="rows"><a class="row settings-link" data-view-jump="compensation" href="/compensation"><div class="row-main"><div class="row-title">Gehalt &amp; Benefits</div><div class="row-sub">Netto, Firmenwagen, bAV, Kaufkraft und Szenarien</div></div><span aria-hidden="true">›</span></a><a class="row settings-link" data-view-jump="import" href="/settings/import"><div class="row-main"><div class="row-title" data-i18n="purchases.import">@Text.Get("purchases.import", language)</div><div class="row-sub">CSV / XLSX · Finanzguru · Finanzfluss · Outbank · Depots</div></div><span aria-hidden="true">›</span></a><button type="button" class="row settings-link" data-view-jump="merchants"><div class="row-main"><div class="row-title" data-i18n="merchants.title">@Text.Get("merchants.title", language)</div><div class="row-sub" data-i18n="merchants.hint">@Text.Get("merchants.hint", language)</div></div><span aria-hidden="true">›</span></button><button type="button" class="row settings-link" data-view-jump="audit"><div class="row-main"><div class="row-title" data-i18n="audit.title">@Text.Get("audit.title", language)</div><div class="row-sub" data-i18n="audit.hint">@Text.Get("audit.hint", language)</div></div><span aria-hidden="true">›</span></button><button id="export-data" type="button" class="row settings-link"><div class="row-main"><div class="row-title" data-i18n="export.title">@Text.Get("export.title", language)</div><div class="row-sub" data-i18n="export.hint">@Text.Get("export.hint", language)</div></div><span aria-hidden="true">↓</span></button></div></article><article class="panel"><div class="panel-head"><h2 data-i18n="sharing.title">@Text.Get("sharing.title", language)</h2><button id="sharing-invite" class="btn btn-secondary" hidden data-i18n="sharing.invite">@Text.Get("sharing.invite", language)</button></div><p class="row-sub panel-intro" data-i18n="sharing.hint">@Text.Get("sharing.hint", language)</p><div id="sharing-members" class="rows"></div><div id="sharing-invites" class="rows" hidden></div></article></section>

@section Styles {
    <link rel="stylesheet" href="/pages/settings/page.css">
}

@section Scripts {
    <script type="module" src="/pages/settings/entry.js"></script>
}
