{
  "ConnectionStrings": {
    "AuthDatabase": ""
  },
  "ReceiptImports": {
    "MaxUploadBytes": 536870912
  },
  "Auth": {
    "MinimumPasswordLength": 12,
    "MaxFailedAccessAttempts": 5,
    "LockoutDuration": "00:15:00"
  },
  "Sessions": {
    "IdleTimeout": "7.00:00:00",
    "AbsoluteLifetime": "7.00:00:00",
    "TouchInterval": "01:00:00",
    "CleanupRetention": "30.00:00:00"
  },
  "Recovery": {
    "CodeCount": 10
  },
  "Passkeys": {
    "RelyingPartyId": "localhost",
    "RelyingPartyName": "FullWorth",
    "Origins": [
      "http://localhost:8080",
      "https://localhost:8080",
      "http://localhost:5000",
      "https://localhost:5001"
    ],
    "ChallengeLifetime": "00:05:00"
  },
  "RateLimits": {
    "Login": {
      "PermitLimit": 10,
      "WindowSeconds": 300,
      "QueueLimit": 0
    },
    "PasswordReset": {
      "PermitLimit": 5,
      "WindowSeconds": 900,
      "QueueLimit": 0
    },
    "Passkey": {
      "PermitLimit": 20,
      "WindowSeconds": 300,
      "QueueLimit": 0
    },
    "BrowserApi": {
      "PermitLimit": 600,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "ReceiptUpload": {
      "PermitLimit": 10,
      "WindowSeconds": 600,
      "QueueLimit": 0
    }
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "Services": {
    "BackendUrl": "http://fullworth-backend:8080",
    "BackendInternalKey": "",
    "BankingUrl": "http://fullworth-banking:8080",
    "BankingApiKey": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Registration": {
    "Enabled": false,
    "SpaceName": "Household",
    "BaseCurrency": "EUR"
  }
}
