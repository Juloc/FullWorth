# FullWorth — minimal self-hosted configuration
# Run: sh scripts/setup-env.sh <your-domain> <admin-email>

FULLWORTH_DOMAIN=fullworth.example.com
FULLWORTH_VERSION=latest

POSTGRES_DB=fullworth
POSTGRES_USER=fullworth
POSTGRES_PASSWORD=change-me

FULLWORTH_BACKEND_INTERNAL_KEY=change-me
FULLWORTH_INGEST_KEY=change-me
FULLWORTH_BANKING_API_KEY=change-me
FULLWORTH_DATA_ENCRYPTION_KEY=change-me

# --- Optional / advanced ------------------------------------------------------

# Bind only to localhost when using Caddy, Traefik or another reverse proxy.
# FULLWORTH_BIND_ADDRESS=127.0.0.1
# FULLWORTH_PORT=8098

# Public account registration. The first admin can also be bootstrapped below.
# FULLWORTH_REGISTRATION_ENABLED=false

# First-run admin bootstrap. Set EMAIL + PASSWORD together, sign in once, then remove them.
# FULLWORTH_BOOTSTRAP_EMAIL=
# FULLWORTH_BOOTSTRAP_PASSWORD=
# FULLWORTH_BOOTSTRAP_DISPLAY_NAME=
# FULLWORTH_BOOTSTRAP_SPACE_NAME=Household
# FULLWORTH_BOOTSTRAP_BASE_CURRENCY=EUR

# Optional social sign-in.
# FULLWORTH_GOOGLE_CLIENT_ID=
# FULLWORTH_GOOGLE_CLIENT_SECRET=
# FULLWORTH_APPLE_SERVICE_ID=
# FULLWORTH_APPLE_TEAM_ID=
# FULLWORTH_APPLE_PRIVATE_KEY_ID=
# FULLWORTH_APPLE_PRIVATE_KEY_BASE64=

# Reverse proxy trust. The Docker bridge default normally works with a local reverse proxy.
# FULLWORTH_KNOWN_PROXY=
# FULLWORTH_KNOWN_PROXY_NETWORK=172.16.0.0/12

# Optional FullWorth Cloud Intelligence enrollment / knowledge-pack verification.
# FULLWORTH_CLOUD_ENROLLMENT_TOKEN=
# FULLWORTH_CLOUD_KNOWLEDGE_PUBLIC_KEY_BASE64=
# FULLWORTH_CLOUD_KNOWLEDGE_PUBLIC_KEY_PATH=
# FULLWORTH_CLOUD_KNOWLEDGE_PACK_ID=fullworth-official
# FULLWORTH_CLOUD_KNOWLEDGE_PACK_REGION=GLOBAL

# Optional local Codex / ChatGPT bridge.
# FULLWORTH_CODEX_BRIDGE_KEY=
# FULLWORTH_CODEX_TEST_ENABLED=false

# Enable Banking credentials are configured per user in the FullWorth UI.
# These legacy/global values are only for existing old installations.
# ENABLE_BANKING_APPLICATION_ID=
# ENABLE_BANKING_PRIVATE_KEY_BASE64=
# ENABLE_BANKING_PRIVATE_KEY_PATH=

# Conservative banking sync defaults. Background sync never runs more often than every 6 hours.
# SYNC_INTERVAL_MINUTES=15
# SYNC_MIN_BACKGROUND_INTERVAL_MINUTES=360
# SYNC_RATE_LIMIT_COOLDOWN_MINUTES=360
# SYNC_OVERLAP_DAYS=7
# SYNC_BATCH_SIZE=250
# ENABLE_BANKING_REQUEST_SPACING_MS=1000
# ENABLE_BANKING_TRANSIENT_RETRIES=2

# FinTS product registration ID, required for ING FinTS.
# FULLWORTH_FINTS_PRODUCT_ID=
