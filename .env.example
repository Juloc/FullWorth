POSTGRES_DB=fullworth
POSTGRES_USER=fullworth
POSTGRES_PASSWORD=change-me

FULLWORTH_BACKEND_INTERNAL_KEY=replace-with-at-least-32-random-characters
FULLWORTH_INGEST_KEY=generate-a-separate-long-random-ingest-key
FULLWORTH_BANKING_API_KEY=generate-a-separate-long-random-banking-key
FULLWORTH_DATA_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
FULLWORTH_PORT=8098
FULLWORTH_BIND_ADDRESS=127.0.0.1

# FullWorth Cloud Intelligence is opt-in from the app's settings (consent-based). The self-hosted app
# ships only the minimal cloud client; no cloud enrollment or knowledge-pack keys are configured here.

# Dedicated internal Codex container. The bridge key enables the per-user "Codex / ChatGPT" AI
# access option in onboarding/settings. The experimental GPT receipt test can be disabled separately.
FULLWORTH_CODEX_BRIDGE_KEY=generate-a-separate-long-random-codex-bridge-key
FULLWORTH_CODEX_TEST_ENABLED=true

# Comma- or semicolon-separated public hostname(s), never '*'.
FULLWORTH_ALLOWED_HOSTS=fullworth.example.com

# Passkeys must match the public HTTPS origin.
FULLWORTH_PASSKEY_RP_ID=fullworth.example.com
FULLWORTH_PASSKEY_ORIGIN=https://fullworth.example.com

# Trusted reverse proxy. Use an exact proxy IP when it is stable. Docker deployments can instead
# trust the bridge CIDR because the gateway IP can change when the stack/network is recreated.
FULLWORTH_KNOWN_PROXY=
FULLWORTH_KNOWN_PROXY_NETWORK=172.16.0.0/12

# First-run admin bootstrap (optional). Set both to have FullWorth.Web create the very first
# user + FullWorth Space on startup, then sign in with these and remove/rotate them afterwards.
FULLWORTH_BOOTSTRAP_EMAIL=
FULLWORTH_BOOTSTRAP_PASSWORD=
FULLWORTH_BOOTSTRAP_DISPLAY_NAME=
FULLWORTH_BOOTSTRAP_SPACE_NAME=Household
FULLWORTH_BOOTSTRAP_BASE_CURRENCY=EUR

# Required for every Enable Banking profile because it is registered as the OAuth-style callback.
ENABLE_BANKING_REDIRECT_URL=https://fullworth.example.com/connect/enable-banking/callback

# Optional legacy/global provider credentials. New installations should leave these empty and use
# Settings -> Enable Banking in FullWorth so every user supplies their own restricted application.
ENABLE_BANKING_APPLICATION_ID=
ENABLE_BANKING_PRIVATE_KEY_BASE64=
ENABLE_BANKING_PRIVATE_KEY_PATH=

# Conservative background-bank access defaults. Code never permits less than 6h.
SYNC_INTERVAL_MINUTES=15
SYNC_MIN_BACKGROUND_INTERVAL_MINUTES=360
SYNC_RATE_LIMIT_COOLDOWN_MINUTES=360
SYNC_OVERLAP_DAYS=7
SYNC_BATCH_SIZE=250
ENABLE_BANKING_REQUEST_SPACING_MS=1000
ENABLE_BANKING_TRANSIENT_RETRIES=2
